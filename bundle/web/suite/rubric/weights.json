  "applicability_rules": {
    "full": "profile weight",
    "limited": "min(profile weight, 1)",
    "not_applicable": "excluded"
  },
  "targets": {
    "modes": {
      "proportional": "default; target by weight used: 3->10, 2->9, 1->8",
      "maximal": "10 for every applicable benchmark",
      "level": "the minimum score each benchmark needs to reach the chosen maturity level (e.g. level:L3)"
    },
    "proportional_by_weight": {
      "3": 10,
      "2": 9,
      "1": 8
    },
    "limited_cap": 8,
    "overrides_note": "Per-benchmark overrides may be set in the project context, e.g. {\"F4\": 10}."
  },
  "overall_cap": {
    "if_any_of": [
      "A1",
      "A2"
    ],
    "score_at_or_below": 3,
    "overall_max": 4.0
  },
  "maturity_levels": [
    {
      "level": "L0",
      "name": "Not viable"
    },
    {
      "level": "L1",
      "name": "Prototype",
      "overall_min": 5.0,
      "pillar_A_min": 4
    },
    {
      "level": "L2",
      "name": "Usable / Beta",
      "overall_min": 6.5,
      "any_min": 4,
      "pillar_A_min": 6,
      "max_critical_gaps": 0
    },
    {
      "level": "L3",
      "name": "Production-ready",
      "overall_min": 8.0,
      "any_min": 6,
      "pillar_A_min": 8,
      "max_critical_gaps": 0,
      "max_major_must_have_gaps": 0,
      "holdout_pass_rate_min": 0.8
    },
    {
      "level": "L4",
      "name": "Exemplary",
      "overall_min": 9.3,
      "any_min": 8,
      "pillar_A_min": 9,
      "max_critical_gaps": 0,
      "max_major_must_have_gaps": 0,
      "tens_require_enforcement": true,
      "holdout_pass_rate_min": 0.95
    }
  ],
  "integrity_rule": "Any integrity flag caps maturity at L1 for that run."
}